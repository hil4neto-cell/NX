{
  "installCommand": "npm ci --prefix apps/nxgeo",
  "buildCommand": "npm run build",
  "outputDirectory": "dist-site",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/regularizacao.html",
      "destination": "/cliente",
      "permanent": true
    },
    {
      "source": "/regularizacao",
      "destination": "/cliente",
      "permanent": true
    }
  ]
}
