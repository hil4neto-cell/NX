{
  "installCommand": "npm ci --prefix apps/nxgeo",
  "buildCommand": "npm run build",
  "outputDirectory": "dist-site",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/nxgeo/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/nxgeo/"
        }
      ]
    },
    {
      "source": "/nxgeo/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/regularizacao.html",
      "destination": "/cliente",
      "permanent": true
    },
    {
      "source": "/regularizacao",
      "destination": "/cliente",
      "permanent": true
    }
  ]
}
